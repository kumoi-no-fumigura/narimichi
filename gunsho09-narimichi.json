 "poems": [
  {
   "seq": "1",
   "text": "いくしほか立波とに染つらんみとりのふかき藤かたのまつ",
   "kana": "",
   "speaker": "成通卿集",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "さもこそは曇りなき世の月ならめみる人まてもすむ心かな",
   "kana": "",
   "speaker": "",
   "page": 120,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "花簿またほにいでぬ宿ならはけふまて秋をしらすやあらまし",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "いつとてか花に心をつけさらんをろかに匂ふ春しなけれは",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "春霞へたつとならは梅花またありけりと風にしらすな",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "逢みむといひわたりしは行末の物おもふ〓とのはしにさりける",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "けふ社はしらせそめつれ戀しさをさりとてやはと思ふ餘りに",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "あかなくによるも紅葉をみよとてや秋しも月のさやけかる覽",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "幾かへり嬉しつらしと思ふらんたのめてあはぬ夜半し積れは",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "玉章のかよふはかりになくさめて後の世まての恨のこすな",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "幾かへりふみかよふとも逢坂をこさすはいかゝ恨みさるへき",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "いかなれは別れは今の心ちしてよはあらぬよに成はてぬらん",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "名殘なくかたりはてぬる世中になかるゝものはなみた成けり",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "さりともとたのみしかけもくれはてゝ淚の雨にぬるゝ頃かな",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "言の葉にいふともつきじ世中は我心にて人をしらなん",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "思ひわび賴む影なきみやの內を歎きてみれはあれぞしにける",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "なけく覽人を誰とはしられとも心もわれにかはらさりけり",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "おぎの葉にあやまたれつゝ吳竹のよるの音にそ秋はきにける",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "草枕よはのけしきのわりなさをおもひやるさへ袖そ露けき",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "思ひやれはるかにゆかぬ時たにも君ごひしさは忘れやはする",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "暮るまも定めなき世としりなから歸りこむ日を待そはかなき",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "なに事を我思はまし時のまも君にはなれぬ身ならましかは",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "さえわたる氷の上にふる雪の消ても物をおもふころかな",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "きゆはかり思はゝなとかあに雪のあはぬ夜半しも積る成らん",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "音羽山をとにきけとや春霞かたゝにみえす立かくすらん",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "鶯やとしのはしめと告つらんなくひとこゑは春めきにけり",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "めにみえぬ心にたにもとまりけり枝なはなれそ春のはつはな",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "水まさるふるえのあやめ今更に生いつと見ゆる五月雨の空",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "一聲のなとつらからんほとゝきすきかて明ぬる夜たに社あれ",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "我宿の物ならなくに匂ひ來る花たちはなのあるしともかな",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "夜もすから妻とふ鹿を聞からに我さへあやないこそれられね",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "女郞花なひくをみねは人しれす秋吹風そうらやまれぬる",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "しら雪の行かふみちをしらせねはまた音つれぬ遠のさと人",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "夜とゝもに霜をくつるを水鳥のうら山しくや下にもゆらん",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "冬ふかく成にけらしな難波江の靑葉ましらぬ芦の村立",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "〓との葉にかけてもいかゝ視ふへき計りをしらぬ君か代なれは",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "あちきなや誰爲思ふ〓となれは我身にかへて人をこふらん",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "限りありて立はなれなは春霞戀しかるへき雲のうへかな",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "雲の上にとまる心のあまりにてなをさへ君は殘しつる哉",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "雲のうへに猶殘しつと聞おりも淚の雨はとまらさりけり",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "雲の上の月はかりをはなかむれと我身もおなし數ならぬ哉",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "雲の上の月を詠むる人ならはかけはなれては思はさらなん",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "雲はるゝ朧月夜の哀さを物おもふ人はいかゝみるらん",
   "kana": "",
   "speaker": "成通〓集",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "いつくにも晴すみまたる月影を我宿からと思ひけるかな",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "夕暮に命をかけぬ身なりせはけさ歸るさにしにやしなまし",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "千年まて君のみそみむ久かたのひさしかるへき秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "まばらにて時雨にいとふ柴の庵は月もるよりそ悔しかりける",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "今よりは山邊に近く家居せじまたいらなくに月かくれけり",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "あかすして過きし野への花薄たつれは道に秋やくれなん",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "ひとりぬる身を浮雲のはれぬよや戀せぬ月もかけに成らん",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "時雨にもかはらぬ竹の綠さへしろくそ見ゆる秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "河竹にすむふ氷とみえつるはなかるゝ夜半の月にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "かほりくる籬をみすは閨のうちに花咲やとゝ人やいはまし",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "宵のまは草葉の露にことよせてひるの袂をいかゝ忍はん",
   "kana": "",
   "speaker": "内",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "紅葉はを折へき物をとあさにて船のよらぬそわりなかりける",
   "kana": "",
   "speaker": "内",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "こよひしも散あは雪はふるとしの罪のきゆへきためし成らん",
   "kana": "",
   "speaker": "",
   "page": 121,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "もろともに千世へん程の久しさはけふの暮るを待にてそしる",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "程もなく入にしよひの月よりもなをうらめしき有明の空",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "しら波に見ゆる垣ねの卯花は我こゝろとやおりつくすらん",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "思ひしりしはしな入そ秋の月こゝまて入をさそふとならは",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "浪たてる荻のからほの夕暮はむれぬるさきにわきそかねつる",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "此里はこなたかなたの山高みみるに程なし長き夜の月",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "むらさきのねすりの衣うらめしき人にやちしほ心そめつも",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "をく網のちゝのめも悲しかしあらはかく迄君を見さらめやは",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "白菊のなをもたのまし年をへて心にそめぬ秋しなけれは",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "この花の散なん後の心をはなにゝつけてかあかしくらさむ",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "紅葉はをそむる時雨のあたりにや我心さへいろにいてぬらん",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "河岸のふれはちかひてのほる哉これや早せの見する成らむ",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "獨れてまつに久しきかねの音もうしと思はぐあはんよのため",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "是よりはいくらかあらん夕つく日入かゝりぬるおきつしら波",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "たちまちに散とはなしに紅葉はもひころをふれは梢すきけり",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "うつ聲にあはれしらるゝ唐衣つれなき人にきかすべらなり",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "いかにして世にめくれとて月影の我を見すてゝ雲かくるらん",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "曇るとて思ひないりそ世にすまは又もはれなむ冬のよの月",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "たゆましと思ひそめてし道なれは猶ふみかよへ谷のかけはし",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "さりとても慰むへきにあらねとも心かはれるゆへをしらすや",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "花さかぬ我身とおもふにあやしくも春のみ君かたつね來る哉",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "花さかん折をたのめる我なれは來る春〓とにたつぬとをしれ",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "打つけにさひしくもあるか櫻花まれに成ゆくみやまへの里",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "たのめつゝ君かこめよの衣手や待かれ山の雫なるらむ",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "とにかくに程なす夜半そ恨めしきあくる別もうつゝのみかは",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "鶯の人をのみやはさそふへき我もふるすにかへらさらなん",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "おるもおし見すてゝかへる空もなし花下陰に身を盡してむ",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "ひたすらに風をいとはし風しらぬみやまかくれの花も散けり",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "苗代のあらたをかへすいとまなみいつらは永き春日なるらん",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "河霧はたちにけらしな高瀨舟はたうつ棹の音はかりして",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "さくら花あらき風なき君か代にとをよせてそみるへかりける",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "此世にてかきれるなかにあらねとも命はおしき物にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "今よりはあはじとかける玉章のそれより奥は見やはさゝるゝ",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "菖浦草なへてにはあらす長きれの千世迄かけんためしとはみよ",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "戀ひわひておほくの年を吳竹のたゝひとかたに嬉しと思はゝ",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "はちす葉に消にし露をもらさじと契りを結ふ花としらすや",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "消ぬへき命にかけてたのむそよ露もあたにはおもはさらなん",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "花を見る程のみ物を思はねはおしさはいかゝなへてなるへき",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "靑柳のあなたに匂ふ花の色は峯こす風の便りにそみる",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "いかてかはなへてなるへき櫻ちる庭さへはらふ風のつらさは",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "まつときはいてゝもいですおしむ間はいらめに入や有明の月",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "雲の上にあさゆふかくるたのみをは天照神はいかにしつると",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "雲の上にふきあけの濵を待かねて神のみつかのうらめしき哉",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
  "work_id": "gunsho09-narimichi",
